PORT=4002
MONGO_URL=mongodb://localhost:27017/nebron_core
REDIS_URL=redis://localhost:6379
AUTH_JWKS_URL=http://localhost:4001/.well-known/jwks.json
EVENTS_STREAM=nebron.events
EVENTS_GROUP=core-api
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
NODE_ENV=development
LOG_LEVEL=info

# Cloudflare R2 / S3
R2_ACCOUNT_ID=
R2_ENDPOINT=http://localhost:9000
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin
R2_BUCKET=nebron-media
R2_PUBLIC_BASE_URL=http://localhost:9000/nebron-media
MAX_AVATAR_BYTES=5242880
MAX_BANNER_BYTES=10485760

# Preferences & Localization
SUPPORTED_LANGUAGES=en,hi,ta,te,ml,kn,bn,mr,gu,pa,ur
DEFAULT_LANGUAGE=en

# Internal
INTERNAL_TOKEN=dev-internal-token
